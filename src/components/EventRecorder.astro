---
// A multi-pen event recorder: every channel's pen steps up while that role or
// study was running. A rotary switch picks which pens are down on the paper.
// Purely visual; the lists below it carry the same content.

export interface Channel {
  label: string;
  period: string;
  kind: 'work' | 'study';
}

interface Props {
  channels: Channel[];
  caption: string;
}

const { channels, caption } = Astro.props;

const months: Record<string, number> = {
  jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11,
};

// Turns "Jul 2023" or "2024" into a fractional year. A bare year is read as an
// academic year boundary: September when it starts a period, July when it ends one.
function toYear(part: string, isEnd: boolean): number {
  const [a, b] = part.trim().split(/\s+/);
  if (b) return Number(b) + (months[a.slice(0, 3).toLowerCase()] + (isEnd ? 1 : 0)) / 12;
  return Number(a) + (isEnd ? 7 : 8) / 12;
}

const spans = channels.map((c, i) => {
  const [start, end] = c.period.split(/\s*[–-]\s*/);
  return { ...c, channel: i + 1, ink: (i % 4) + 1, from: toYear(start, false), to: toYear(end ?? start, true) };
});

const now = new Date();
const nowYear = now.getFullYear() + now.getMonth() / 12;
const firstYear = Math.floor(Math.min(...spans.map((s) => s.from)));
const lastYear = Math.ceil(Math.max(nowYear, ...spans.map((s) => s.to)));
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const quarters = Array.from({ length: (lastYear - firstYear) * 4 + 1 }, (_, i) => firstYear + i / 4);

// Two layouts: a wide one with the names in a column on the left, and a narrow
// one for phones with each name written above its pen.
function layout(width: number, left: number, lane: number, labelAbove: boolean) {
  const right = 16;
  const top = 36;
  const height = top + spans.length * lane + 18;
  const x = (year: number) => left + ((year - firstYear) / (lastYear - firstYear)) * (width - left - right);
  const lanes = spans.map((s, i) => {
    const low = top + (i + 1) * lane - 7;
    const high = low - (labelAbove ? 13 : 16);
    const x1 = x(s.from);
    const x2 = x(s.to);
    return {
      ...s,
      low,
      high,
      labelX: labelAbove ? left : 12,
      labelY: labelAbove ? low - 17 : low - 4,
      band: { x: x1, y: high, w: x2 - x1, h: low - high },
      d: `M${left} ${low} H${x1.toFixed(1)} V${high} H${x2.toFixed(1)} V${low} H${width - right}`,
    };
  });
  const holes = Array.from({ length: Math.floor(width / 36) }, (_, i) => 18 + i * 36);
  return { width, left, right, height, x, lanes, holes, nowX: x(nowYear) };
}

const wide = layout(820, 150, 34, false);
const narrow = layout(340, 10, 44, true);
const layouts = [
  { cls: 'rec-wide', ...wide, yearLabel: (y: number) => String(y) },
  { cls: 'rec-narrow', ...narrow, yearLabel: (y: number) => `’${String(y).slice(2)}` },
];

const positions = [
  { id: 'rec-all', label: 'All', value: 'all' },
  { id: 'rec-work', label: 'Work', value: 'work' },
  { id: 'rec-study', label: 'Study', value: 'study' },
];
---

<figure class="recorder">
  <fieldset class="selector">
    <legend>Pens</legend>
    {positions.map((p, i) => (
      <span class={`selector-pos pos-${p.value}`}>
        <input type="radio" name="recorder-pens" id={p.id} value={p.value} checked={i === 0} />
        <label for={p.id}>{p.label}</label>
      </span>
    ))}
    <span class="selector-knob" aria-hidden="true"></span>
  </fieldset>
  <div class="recorder-window" tabindex="0" role="group" aria-label={caption}>
    {layouts.map((l) => (
      <svg class={l.cls} viewBox={`0 0 ${l.width} ${l.height}`} aria-hidden="true" focusable="false">
        <rect class="paper" width={l.width} height={l.height} />
        {quarters.map((q) => (
          <line class:list={['grid', { major: Number.isInteger(q) }]} x1={l.x(q)} x2={l.x(q)} y1="14" y2={l.height - 10} />
        ))}
        {l.lanes.map((t) => (
          <line class="grid" x1={l.left} x2={l.width - l.right} y1={t.low} y2={t.low} />
        ))}
        {years.map((y) => (
          <text class="scale" x={l.x(y)} y="28">{l.yearLabel(y)}</text>
        ))}
        {l.holes.map((h) => (
          <>
            <circle class="sprocket" cx={h} cy="6" r="2.6" />
            <circle class="sprocket" cx={h} cy={l.height - 5} r="2.6" />
          </>
        ))}
        <line class="now" x1={l.nowX} x2={l.nowX} y1="32" y2={l.height - 12} />
        {l.lanes.map((t) => (
          <g class={`lane ${t.kind}`}>
            <text class={`channel ink-${t.ink}`} x={t.labelX} y={t.labelY}>{t.label}</text>
            <rect class={`band ink-${t.ink}`} x={t.band.x} y={t.band.y} width={t.band.w} height={t.band.h} />
            <path class={`trace ink-${t.ink}`} d={t.d} />
          </g>
        ))}
      </svg>
    ))}
  </div>
  <figcaption>{caption}</figcaption>
</figure>
