---
// Edgewise vertical meter. `value` runs from 0 to 100; the label and reading
// are rendered as text so the meter itself is decoration.

interface Props {
  label: string;
  reading: string;
  value: number;
}

const { label, reading, value } = Astro.props;

const top = 22;
const bottom = 278;
const y = (v: number) => bottom - (Math.max(0, Math.min(100, v)) / 100) * (bottom - top);
const ticks = Array.from({ length: 21 }, (_, i) => i * 5);
const bands = [
  { v: 20, text: 'Basic' },
  { v: 50, text: 'Working' },
  { v: 80, text: 'Fluent' },
  { v: 100, text: 'Native' },
];
const pointer = y(value);
---

<li class="meter">
  <svg viewBox="0 0 120 300" aria-hidden="true" focusable="false">
    <rect class="meter-bezel" x="1" y="1" width="118" height="298" rx="6" />
    <rect class="meter-face" x="9" y="9" width="102" height="282" rx="3" />
    {ticks.map((t) => (
      <line
        class:list={['meter-tick', { major: bands.some((b) => b.v === t) }]}
        x1={bands.some((b) => b.v === t) ? 70 : 77}
        x2="86"
        y1={y(t)}
        y2={y(t)}
      />
    ))}
    {bands.map((b) => (
      <text class="meter-scale" x="66" y={y(b.v) + 4.5}>{b.text}</text>
    ))}
    <rect class="meter-track" x="90" y={top} width="12" height={bottom - top} />
    <rect class="meter-bar" x="90" y={pointer} width="12" height={bottom - pointer} />
    <path class="meter-pointer" d={`M84 ${pointer} l18 -8 v16 z`} />
  </svg>
  <span class="meter-label">{label}</span>
  <span class="meter-reading">{reading}</span>
</li>
