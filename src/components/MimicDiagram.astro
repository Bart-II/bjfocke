---
// Decorative mimic diagram of a pressurised water reactor plant, drawn the way
// old control boards showed the process: coloured pipe runs between components.
---

<svg class="mimic" viewBox="0 0 320 160" aria-hidden="true" focusable="false">
  <!-- Primary loop -->
  <path class="pipe primary" d="M66 52 H118" />
  <path class="pipe primary flow" d="M66 52 H118" />
  <path class="pipe primary" d="M118 112 H66" />
  <path class="pipe primary flow" d="M118 112 H66" />
  <circle class="pump" cx="92" cy="112" r="6" />

  <!-- Secondary loop -->
  <path class="pipe secondary" d="M144 44 H170 V38 H192" />
  <path class="pipe secondary flow" d="M144 44 H170 V38 H192" />
  <path class="pipe secondary" d="M216 62 V96" />
  <path class="pipe secondary flow" d="M216 62 V96" />
  <path class="pipe secondary" d="M192 120 H170 V116 H144" />
  <path class="pipe secondary flow" d="M192 120 H170 V116 H144" />
  <circle class="pump" cx="170" cy="120" r="6" />

  <!-- Cooling water -->
  <path class="pipe cooling" d="M250 104 H300 M250 122 H300" />
  <path class="pipe cooling flow" d="M300 104 H250 M250 122 H300" />

  <!-- Reactor vessel with control rods and core -->
  <g class="rods">
    <path d="M32 8 V70 M40 8 V64 M48 8 V70 M56 8 V64" />
  </g>
  <rect class="vessel" x="20" y="24" width="48" height="112" rx="22" />
  <path class="rods-inside" d="M32 24 V70 M40 24 V64 M48 24 V70 M56 24 V64" />
  <rect class="core" x="28" y="74" width="32" height="44" rx="3" />

  <!-- Steam generator -->
  <rect class="vessel" x="112" y="26" width="34" height="108" rx="16" />
  <path class="tubes" d="M122 132 V60 Q129 48 136 60 V132" />

  <!-- Turbine, generator and condenser -->
  <path class="vessel" d="M192 30 L240 18 V70 L192 58 Z" />
  <path class="shaft" d="M240 44 H258" />
  <circle class="vessel" cx="274" cy="44" r="16" />
  <text class="mimic-mark" x="274" y="48.5">G</text>
  <rect class="vessel" x="192" y="96" width="58" height="34" rx="4" />

  <g class="mimic-labels">
    <text x="44" y="152">Reactor</text>
    <text x="129" y="152">Steam gen</text>
    <text x="216" y="84">Turbine</text>
    <text x="221" y="148">Condenser</text>
  </g>
</svg>
