---
import '@fontsource/barlow-condensed/latin-500.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';
import { profile } from '../data/resume';

interface Props {
  title?: string;
  description?: string;
  /** Which position the rotary selector in the header points at. */
  section?: 'overview' | 'experience' | 'projects' | 'interests' | 'contact';
}

const {
  title,
  description = `${profile.name}: ${profile.headline}. ${profile.subheadline}.`,
  section = 'overview',
} = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.headline}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const csp = [
  "default-src 'none'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');

// Positions of the rotary mode selector, left to right.
const positions = [
  { id: 'overview', label: 'Overview', href: `${base}/` },
  { id: 'experience', label: 'Experience', href: `${base}/#experience` },
  { id: 'projects', label: 'Projects', href: `${base}/projects/` },
  { id: 'interests', label: 'Interests', href: `${base}/#interests` },
  { id: 'contact', label: 'Contact', href: `${base}/#contact` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand plate" href={`${base}/`}>
          <span class="brand-name">{profile.name}</span>
          <span class="brand-unit">Unit 1 · Main control board</span>
        </a>
        <nav class="rotary" aria-label="Main" data-pos={section}>
          <span class="rotary-caption" aria-hidden="true">Mode select</span>
          <ul>
            {positions.map((p) => (
              <li class={`pos-${p.id}`}>
                <a href={p.href} aria-current={p.id === section ? 'page' : undefined}>{p.label}</a>
              </li>
            ))}
          </ul>
          <span class="knob" aria-hidden="true"></span>
        </nav>
      </div>
    </header>
    <main class="container" id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} {profile.name} · No cookies, no trackers, no JavaScript.</p>
    </footer>
  </body>
</html>
