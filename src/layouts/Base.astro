---
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '../styles/global.css';
import { profile } from '../data/resume';

interface Props {
  title?: string;
  description?: string;
  /** Which header link is marked as the current page. */
  section?: 'experience' | 'projects' | 'interests' | 'contact';
}

const {
  title,
  description = `${profile.name}: ${profile.headline}. ${profile.subheadline}.`,
  section,
} = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.headline}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const csp = [
  "default-src 'none'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');

// Header navigation, left to right.
const links = [
  { id: 'experience', label: 'Experience', href: `${base}/#experience` },
  { id: 'projects', label: 'Projects', href: `${base}/projects/` },
  { id: 'interests', label: 'Interests', href: `${base}/#interests` },
  { id: 'contact', label: 'Contact', href: `${base}/#contact` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={`${base}/`}>{profile.name}</a>
        <nav class="nav" aria-label="Main">
          <ul>
            {links.map((p) => (
              <li>
                <a href={p.href} aria-current={p.id === section ? 'page' : undefined}>{p.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="container" id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} {profile.name} · No cookies, no trackers, no JavaScript.</p>
    </footer>
  </body>
</html>
