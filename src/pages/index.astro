---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MimicDiagram from '../components/MimicDiagram.astro';
import EventRecorder from '../components/EventRecorder.astro';
import VerticalMeter from '../components/VerticalMeter.astro';
import { profile, experience, education, skills, languages, interests } from '../data/resume';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = (await getCollection('projects', (p) => p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Annunciator windows. Alarms stay dark until the lamp test switch is thrown.
const annunciators = [
  { text: 'Information security', kind: 'lit' },
  { text: 'Governance', kind: 'lit' },
  { text: 'Reactor trip', kind: 'alarm' },
  { text: 'Incident response', kind: 'lit' },
  { text: 'Security policy', kind: 'lit' },
  { text: 'NATO NCI Agency', kind: 'lit' },
  { text: 'Coolant flow low', kind: 'alarm' },
  { text: 'Ministry of the Interior', kind: 'lit' },
  { text: 'European economics', kind: 'lit' },
];

// Experience runs on channels 1–3 of the recorder, education on the channels after it.
const channels = [
  ...experience.map((r) => ({ label: r.title, period: r.period })),
  ...education.map((s) => ({ label: s.degree, period: s.period })),
];
---

<Base section="overview">
  <section class="panel hero" id="about">
    <div class="hero-text">
      <h1>{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <p class="sub">{profile.subheadline} · {profile.location}</p>
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      <ul class="buttons">
        {profile.cv.map((cv) => (
          <li><a class="button primary" href={`${base}/${cv.file}`}><span class="visually-hidden">Download </span>{cv.label}</a></li>
        ))}
        <li><a class="button" href={profile.links.linkedin} rel="me noopener">LinkedIn</a></li>
        <li><a class="button" href={profile.links.github} rel="me noopener">GitHub</a></li>
      </ul>
    </div>
    <div class="hero-board">
      <MimicDiagram />
      <div class="annunciator-bay">
        <ul class="annunciator" aria-label="Focus areas">
          {annunciators.map((a) => (
            <li class={`tile ${a.kind}`} aria-hidden={a.kind === 'alarm' ? 'true' : undefined}>{a.text}</li>
          ))}
        </ul>
        <div class="toggle">
          <input type="checkbox" id="lamp-test" />
          <label for="lamp-test">
            <span class="toggle-body" aria-hidden="true"><span class="bat"></span></span>
            <span class="toggle-text">Lamp test</span>
          </label>
        </div>
      </div>
    </div>
  </section>

  <section class="panel" id="experience">
    <h2>Experience</h2>
    <EventRecorder
      channels={channels}
      caption="Event recorder: experience on channels 1 to 3, education on channels 4 to 7."
    />
    <ol class="timeline">
      {experience.map((role, i) => (
        <li>
          <span class={`pen ink-${(i % 4) + 1}`}>CH{i + 1}</span>
          <h3>{role.title}</h3>
          <p class="meta">
            {role.organisation} · {role.period}{role.location && ` · ${role.location}`}
          </p>
          <p>{role.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="panel" id="projects">
    <h2>Featured projects</h2>
    <div class="cards">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="more"><a href={`${base}/projects/`}>All projects →</a></p>
  </section>

  <section class="panel" id="education">
    <h2>Education</h2>
    <ol class="timeline">
      {education.map((study, i) => {
        const channel = experience.length + i + 1;
        return (
          <li>
            <span class={`pen ink-${((channel - 1) % 4) + 1}`}>CH{channel}</span>
            <h3>{study.degree}</h3>
            <p class="meta">{study.institution} · {study.period}</p>
            {study.summary && <p>{study.summary}</p>}
          </li>
        );
      })}
    </ol>
  </section>

  <section class="panel" id="skills">
    <h2>Skills</h2>
    <div class="skill-groups">
      {skills.map((group) => (
        <div>
          <h3>{group.group}</h3>
          <ul class="tags keys">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <h3 class="subhead">Languages</h3>
    <ul class="meters">
      {languages.map((l) => <VerticalMeter label={l.language} reading={l.level} value={l.meter} />)}
    </ul>
  </section>

  <section class="panel" id="interests">
    <h2>Interests</h2>
    <div class="cards">
      {interests.map((interest) => (
        <article class="card">
          <h3>{interest.title}</h3>
          <p>{interest.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="panel" id="contact">
    <h2>Contact</h2>
    <p>The best way to reach me is through LinkedIn.</p>
    <ul class="buttons">
      {profile.links.email && <li><a class="button primary" href={profile.links.email}>Email</a></li>}
      <li><a class="button" href={profile.links.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a class="button" href={profile.links.github} rel="me noopener">GitHub</a></li>
    </ul>
  </section>
</Base>
