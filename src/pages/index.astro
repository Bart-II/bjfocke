---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, experience, education, skills, languages, interests } from '../data/resume';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = (await getCollection('projects', (p) => p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const [firstCv, ...otherCvs] = profile.cv;

const months = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];

// Writes "Jul 2023 – Apr 2024" as "2023-07 → 2024-04"; bare years stay as they are.
function isoPeriod(period: string): string {
  return period
    .split(/\s*[–-]\s*/)
    .map((part) => {
      const [a, b] = part.trim().split(/\s+/);
      if (!b) return a;
      const m = months.indexOf(a.slice(0, 3).toLowerCase());
      return m < 0 ? part : `${b}-${String(m + 1).padStart(2, '0')}`;
    })
    .join(' → ');
}
---

<Base>
  <section class="terminal hero" id="about">
    <p class="titlebar" aria-hidden="true"><span class="dots"></span>bart@voorschoten: ~</p>
    <div class="screen">
      <p class="prompt" aria-hidden="true">whoami</p>
      <h1>{profile.name}<span class="cursor" aria-hidden="true"></span></h1>
      <p class="lede">{profile.headline}</p>
      <p class="sub">{profile.subheadline} · {profile.location}</p>
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      <ul class="buttons">
        <li><a class="button primary" href={`${base}/${firstCv.file}`}>Download {firstCv.label}</a></li>
        {otherCvs.map((cv) => (
          <li><a class="button" href={`${base}/${cv.file}`}>{cv.label}</a></li>
        ))}
        <li><a class="button" href={profile.links.linkedin} rel="me noopener">LinkedIn</a></li>
        <li><a class="button" href={profile.links.github} rel="me noopener">GitHub</a></li>
      </ul>
    </div>
  </section>

  <section id="experience">
    <h2>Experience</h2>
    <ol class="entries">
      {experience.map((role) => (
        <li class="entry">
          <p class="when">{isoPeriod(role.period)}</p>
          <h3>{role.title}</h3>
          <p class="meta">{role.organisation}{role.location && ` · ${role.location}`}</p>
          <p>{role.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="projects">
    <h2>Featured projects</h2>
    <div class="cards">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="more"><a href={`${base}/projects/`}>All projects →</a></p>
  </section>

  <section id="education">
    <h2>Education</h2>
    <ol class="entries">
      {education.map((study) => (
        <li class="entry">
          <p class="when">{isoPeriod(study.period)}</p>
          <h3>{study.degree}</h3>
          <p class="meta">{study.institution}</p>
          {study.summary && <p>{study.summary}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section id="skills">
    <h2>Skills</h2>
    <dl class="skills">
      {skills.map((group) => (
        <div>
          <dt>{group.group}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))}
      <div>
        <dt>Languages</dt>
        <dd>{languages.map((l) => `${l.language} (${l.level.toLowerCase()})`).join(', ')}</dd>
      </div>
    </dl>
  </section>

  <section id="interests">
    <h2>Interests</h2>
    <div class="cards">
      {interests.map((interest) => (
        <article class="card">
          <h3>{interest.title}</h3>
          <p>{interest.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>The best way to reach me is through LinkedIn.</p>
    <ul class="buttons">
      {profile.links.email && <li><a class="button primary" href={profile.links.email}>Email</a></li>}
      <li><a class="button primary" href={profile.links.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a class="button" href={profile.links.github} rel="me noopener">GitHub</a></li>
    </ul>
  </section>
</Base>
