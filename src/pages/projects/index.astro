---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Projects by Bart Fokke in information security, governance and software." section="projects">
  <section class="page-intro">
    <p class="prompt" aria-hidden="true">ls projects/</p>
    <h1>Projects</h1>
    <p>Work, study and personal projects.</p>
    <div class="cards">
      {projects.map((project) => <ProjectCard project={project} level={2} />)}
    </div>
  </section>
</Base>
